{
  "name": "dsh-plugin-session-cost",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Shows what the current session has cost, plus the signed-in DeepSeek account balance, in the composer dock.",
  "license": "AGPL-3.0-or-later",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "wallet-ledger.js",
    "client.js",
    "icon.svg",
    "locale/*.json",
    "cost-fold.js",
    "verify-cost-fold.mjs",
    "accounts.js",
    "cordis.patch.yml",
    "runtime.js",
    "ledger.js",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/*.txt",
    "docs/*.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "meta": {
    "title": "会话花费与余额",
    "description": "在输入框下方显示本会话已花费的金额与账号余额。"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ygnstudio/dsh-plugin-session-cost.git"
  },
  "homepage": "https://github.com/ygnstudio/dsh-plugin-session-cost#readme",
  "bugs": {
    "url": "https://github.com/ygnstudio/dsh-plugin-session-cost/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "cost-tracking",
    "balance"
  ],
  "author": "ygnstudio"
}
